# ── Dependências ─────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build do Next.js ─────────────────────────────────────────
/.next/
# pasta de build usada só pelos testes e2e
/.next-e2e/
/out/
/build
# gerado pelo Next a cada dev/build
next-env.d.ts
*.tsbuildinfo

# ── Variáveis de ambiente (segredos) ─────────────────────────
# Tudo que começa com .env fica de fora, menos o modelo sem segredos.
.env*
!.env.example

# ── Banco de dados local (SQLite) ────────────────────────────
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# ── Testes ───────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Deploy ───────────────────────────────────────────────────
.vercel

# ── Chaves e certificados ────────────────────────────────────
*.pem

# ── Editor e sistema operacional ─────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# ── Configuração local de assistentes de IA ──────────────────
.claude/settings.local.json
